# Copy to .env and fill in the values used by the HRCRM web app (hrcrm.ai repo):
#   VITE_SMARTGATEWAY_SECRET_KEY  ->  EXPO_PUBLIC_SMARTGATEWAY_SECRET_KEY
#   VITE_FETCHGPC_X_API_KEY       ->  EXPO_PUBLIC_FETCHGPC_X_API_KEY
# After changing .env restart Metro with: npm run start:fresh

EXPO_PUBLIC_SMARTGATEWAY_SECRET_KEY=
EXPO_PUBLIC_FETCHGPC_X_API_KEY=
EXPO_PUBLIC_RECRUITMENT_API_URL=https://recruitmentbackend.outrightsystems.org/api

# Optional: Web-type OAuth client ID from the Google Cloud project behind the HRCRM login.
# When set, "Continue with Google" opens the native Google account dialog
# (also needs an Android OAuth client with this app's SHA-1, and the backend
# googleTokenLogin route). Leave empty to sign in through the web flow.
GOOGLE_WEB_CLIENT_ID=

# Optional: Application (client) ID of the Azure app registration behind the HRCRM Microsoft login.
# When set, "Continue with Microsoft" opens Microsoft's sign-in page in a browser tab
# (also needs the redirect URI ai.hrcrm.app://oauth/redirect in Azure, and the backend
# microsoftTokenLogin route). Leave empty to sign in through the web flow.
MICROSOFT_CLIENT_ID=
# Directory (tenant) ID, only for a single-tenant Azure app. Leave empty for multitenant.
MICROSOFT_TENANT_ID=
